<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New Tenant"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/tenantNameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tenant Name"
        android:inputType="textPersonName" />

    <EditText
        android:id="@+id/tenantPhoneEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone Number"
        android:inputType="phone"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/tenantRentEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Rent Paid (KSh)"
        android:inputType="numberDecimal"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/saveTenantButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Tenant"
        android:layout_marginTop="24dp" />

</LinearLayout>
