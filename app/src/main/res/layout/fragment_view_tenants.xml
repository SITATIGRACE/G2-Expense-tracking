<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/viewTenantsTitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registered Tenants"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/totalRentTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Rent: KSh 0.00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/newTenantGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/newTenantTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/callButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call Tenant" />
    </LinearLayout>

    <TextView
        android:id="@+id/allTenantsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No tenants registered yet."
        android:textSize="16sp" />

</LinearLayout>
