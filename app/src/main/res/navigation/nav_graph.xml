<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.tenantmanagementsytem.DashboardFragment"
        android:label="Dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_addTenantFragment"
            app:destination="@id/addTenantFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_dashboardFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/addTenantFragment"
        android:name="com.example.tenantmanagementsytem.AddTenantFragment"
        android:label="Add Tenant">

        <action
            android:id="@+id/action_addTenantFragment_to_viewTenantsFragment"
            app:destination="@id/viewTenantsFragment"
            app:popUpTo="@id/dashboardFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/viewTenantsFragment"
        android:name="com.example.tenantmanagementsytem.ViewTenantsFragment"
        android:label="View Tenants">

        <argument
            android:name="newTenant"
            app:argType="com.example.tenantmanagementsytem.Tenant"
            app:nullable="true"
            android:defaultValue="@null" /> <!-- FIXED HERE: Added default value -->

    </fragment>

</navigation>
